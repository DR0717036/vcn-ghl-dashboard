{
  "name": "vcn-ghl-dashboard",
  "version": "0.1.0",
  "description": "Veteran Careers Network GHL sales dashboard (read-only against Go High Level)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/reconcile-gate.mjs",
    "build": "next build",
    "check": "npm run typecheck && npm test",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check-connection": "node scripts/check-connection.mjs"
  },
  "dependencies": {
    "next": "^16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
