GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Optional: base URL of your GHL web app for contact links (default https://app.gohighlevel.com)
GHL_APP_BASE_URL=
# Sign in with Google (Auth.js). Create the OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte secret used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Hosting (Render; see docs/DEPLOY.md). DATA_DIR is the mounted persistent disk that holds the SQLite cache (render.yaml sets /data).
DATA_DIR=
# Public https address of the deployed app, e.g. https://vcn-ghl-dashboard.onrender.com (no trailing slash)
AUTH_URL=
# Keep Node's clock in the reporting timezone on the host (render.yaml sets this)
TZ=America/New_York
# Port the server listens on (render.yaml sets 3000; Next reads PORT)
PORT=
# Weekly sales report email (config/weekly-report.json): the Gmail account that sends it and its app password
# (Google Account > Security > 2-Step Verification > App passwords). Never the normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Anthropic API key for the report's narrative (trend commentary, projections wording, three tips; model in config/assistant.json).
# Optional: without it the email is sent with numbers only.
ANTHROPIC_API_KEY=

# Scheduled report sends run only where NODE_ENV is production (the host). Set this to 1 to let a
# development server send on schedule too (normally never; previews and test sends work without it).
# WEEKLY_REPORT_SCHEDULER=1
