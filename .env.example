GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Optional: base URL of your GHL web app for contact links (default https://app.gohighlevel.com)
GHL_APP_BASE_URL=
# Sign in with Google (Auth.js). Create the OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte secret used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Hosting (Render; see docs/DEPLOY.md). DATA_DIR is the mounted persistent disk that holds the SQLite cache (render.yaml sets /data).
DATA_DIR=
# Public https address of the deployed app, e.g. https://vcn-ghl-dashboard.onrender.com (no trailing slash)
AUTH_URL=
# Keep Node's clock in the reporting timezone on the host (render.yaml sets this)
TZ=America/New_York
# Port the server listens on (render.yaml sets 3000; Next reads PORT)
PORT=
